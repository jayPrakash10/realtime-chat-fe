# Copy this file to .env and adjust the values.
# scripts/generate-env.mjs reads it before `npm start`, `npm run build` and `npm test`
# and writes src/environments/environment.ts. Shell variables with the same names win.

# REST API base URL, including /api/v1
NG_APP_API_BASE_URL=http://localhost:5000/api/v1

# Server origin: used for images (/uploads/...) and the Socket.IO connection
NG_APP_SERVER_ORIGIN=http://localhost:5000

# true = run entirely in the browser with mock data (MSW + a fake socket). No backend needed.
NG_APP_USE_MOCKS=false
